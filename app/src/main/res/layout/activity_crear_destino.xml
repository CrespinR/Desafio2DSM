<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear destino"
            android:textSize="@dimen/text_xlarge"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_large" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del destino"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:inputType="textCapSentences" />

        <Spinner
            android:id="@+id/spPais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium" />

        <EditText
            android:id="@+id/etPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:inputType="numberDecimal"
            android:layout_marginTop="@dimen/margin_medium" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Descripción"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginTop="@dimen/margin_medium" />

        <ImageView
            android:id="@+id/imgVistaPrevia"
            android:layout_width="match_parent"
            android:layout_height="@dimen/imagen_destino_height"
            android:layout_marginTop="@dimen/margin_medium"
            android:scaleType="centerCrop"
            android:src="@drawable/destino_default"
            android:contentDescription="Vista previa del destino" />

        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver imagen del destino"
            android:textColor="@color/text_icons"
            android:backgroundTint="@color/accent"
            android:layout_marginTop="@dimen/margin_medium" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar destino"
            android:textColor="@color/text_icons"
            android:backgroundTint="@color/purple_dark"
            android:layout_marginTop="@dimen/margin_large" />

    </LinearLayout>

</ScrollView>